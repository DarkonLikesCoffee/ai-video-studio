{
  "schemaVersion": 1,
  "id": "internet-explainer-with-media",
  "title": "How the Internet Connects Us",
  "description": "A three-scene explainer demonstrating text, a local SVG image, and an MP4 video clip.",
  "composition": {
    "id": "ProjectVideo",
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "scenes": [
    {
      "id": "opening",
      "type": "title",
      "durationInFrames": 90,
      "eyebrow": "A CONNECTED WORLD",
      "title": "The Internet Connects Us",
      "body": "Every message, page, and video starts with a connection.",
      "backgroundColor": "#0B1020",
      "accentColor": "#67E8F9",
      "media": {
        "type": "image",
        "src": "assets/connection-map.svg",
        "placement": "right",
        "fit": "contain",
        "opacity": 1
      }
    },
    {
      "id": "journey",
      "type": "content",
      "durationInFrames": 120,
      "eyebrow": "FOLLOW THE DATA",
      "title": "How information travels",
      "body": "Your device sends a request through networks to a server. The server responds, and the information travels back to you.",
      "backgroundColor": "#101426",
      "accentColor": "#A78BFA",
      "media": {
        "type": "video",
        "src": "https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4",
        "placement": "background",
        "fit": "cover",
        "position": "center",
        "opacity": 0.7,
        "muted": true,
        "playbackRate": 1
      }
    },
    {
      "id": "ending",
      "type": "outro",
      "durationInFrames": 90,
      "eyebrow": "ONE GLOBAL NETWORK",
      "title": "A world of possibilities",
      "body": "That is the internet: billions of connected devices sharing information.",
      "backgroundColor": "#111827",
      "accentColor": "#34D399"
    }
  ],
  "output": {
    "format": "mp4",
    "codec": "h264"
  }
}
