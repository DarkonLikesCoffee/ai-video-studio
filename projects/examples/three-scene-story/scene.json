{
  "schemaVersion": 1,
  "id": "internet-explainer-with-media",
  "title": "How the Internet Connects Us",
  "description": "A three-scene explainer showing multiple simultaneous media layers, local image overlays, and remote video footage.",
  "composition": {
    "id": "ProjectVideo",
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "scenes": [
    {
      "id": "opening",
      "type": "title",
      "durationInFrames": 90,
      "eyebrow": "A CONNECTED WORLD",
      "title": "The Internet Connects Us",
      "body": "Every message, page, and video starts with a connection.",
      "backgroundColor": "#0B1020",
      "accentColor": "#67E8F9",
      "mediaLayers": [
        {
          "id": "connection-map",
          "type": "image",
          "src": "assets/connection-map.svg",
          "x": 54,
          "y": 10,
          "width": 42,
          "height": 80,
          "fit": "contain",
          "opacity": 0.96,
          "zIndex": 1
        },
        {
          "id": "connection-badge",
          "type": "image",
          "src": "assets/connection-map.svg",
          "x": 70,
          "y": 58,
          "width": 18,
          "height": 32,
          "fit": "contain",
          "opacity": 0.9,
          "rotation": -7,
          "zIndex": 3,
          "startInFrames": 18,
          "durationInFrames": 72
        }
      ]
    },
    {
      "id": "journey",
      "type": "content",
      "durationInFrames": 120,
      "eyebrow": "FOLLOW THE DATA",
      "title": "How information travels",
      "body": "Your device sends a request through networks to a server. The server responds, and the information travels back to you.",
      "backgroundColor": "#101426",
      "accentColor": "#A78BFA",
      "mediaLayers": [
        {
          "id": "flower-footage",
          "type": "video",
          "src": "https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4",
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 100,
          "fit": "cover",
          "position": "center",
          "opacity": 0.62,
          "muted": true,
          "playbackRate": 1,
          "zIndex": 0
        },
        {
          "id": "network-overlay",
          "type": "image",
          "src": "assets/connection-map.svg",
          "x": 66,
          "y": 48,
          "width": 27,
          "height": 43,
          "fit": "contain",
          "opacity": 0.9,
          "rotation": 4,
          "zIndex": 5,
          "startInFrames": 25,
          "durationInFrames": 95
        }
      ]
    },
    {
      "id": "ending",
      "type": "outro",
      "durationInFrames": 90,
      "eyebrow": "ONE GLOBAL NETWORK",
      "title": "A world of possibilities",
      "body": "That is the internet: billions of connected devices sharing information.",
      "backgroundColor": "#111827",
      "accentColor": "#34D399"
    }
  ],
  "output": {
    "format": "mp4",
    "codec": "h264"
  }
}
