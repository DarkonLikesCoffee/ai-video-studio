{
  "name": "ai-video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ai-video-studio/studio",
    "build": "npm run build --workspace @ai-video-studio/studio",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "validate:demo": "tsx scripts/validate-project.ts projects/demo/scene.json",
    "validate:project": "tsx scripts/validate-project.ts",
    "render": "npm run render --workspace @ai-video-studio/video-engine",
    "render:custom": "npm run render:custom --workspace @ai-video-studio/video-engine --",
    "assets:audio": "tsx scripts/generate-audio-fixtures.ts",
    "assets:commons-video": "node scripts/commons-video-assets.mjs",
    "assets:nasa-video": "node scripts/nasa-video-assets.mjs",
    "audio:prepare": "tsx scripts/prepare-project-audio.ts",
    "audio:master": "tsx scripts/master-audio.ts",
    "validate:plan": "tsx scripts/validate-production-plan.ts",
    "narration:apply": "tsx scripts/apply-narration.ts",
    "qa:media": "tsx scripts/qa-media.ts",
    "storyboard:qa": "tsx scripts/storyboard-qa.ts",
    "storyboard:preview": "tsx scripts/storyboard-preview.ts",
    "storyboard:critic": "tsx scripts/storyboard-critic.ts",
    "storyboard:strategy": "tsx scripts/storyboard-strategy.ts",
    "storyboard:revision": "tsx scripts/storyboard-revision.ts",
    "storyboard:beats": "tsx scripts/storyboard-beats.ts",
    "director:brief": "tsx scripts/director-brief.ts",
    "director:storyboard-prompt": "tsx scripts/director-storyboard-prompt.ts",
    "director:production-plan": "tsx scripts/director-production-plan.ts",
    "qa:contact-sheet": "tsx scripts/qa-contact-sheet.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
